@page "/produtos"

<h3>Produtos</h3>

<div class="row">
    <div class="col-md-4">
        <div class="card card-body">

            <EditForm Model="@produto" OnValidSubmit="@AdicionarProduto">

                <DataAnnotationsValidator />

                <label class="form-label">Nome</label>
                <InputText class="form-control" @bind-Value="produto.Nome" />
                <ValidationMessage For="@(() => produto.Nome)" class="text-danger" />

                <label class="form-label mt-2">Preço</label>
                <InputNumber class="form-control" @bind-Value="produto.Preco" />
                <ValidationMessage For="@(() => produto.Preco)" class="text-danger" />

                <label class="form-label mt-2">Quantidade</label>
                <InputNumber class="form-control" @bind-Value="produto.Quantidade" />

                <button type="submit" class="btn btn-primary mt-3">
                    Adicionar Produto
                </button>

            </EditForm>

            @if (!string.IsNullOrEmpty(mensagem))
            {
                <p class="text-success mt-3">@mensagem</p>
            }

        </div>
    </div>

    <div class="col-md-8">
        <div class="card card-body">

            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Nome</th>
                        <th>Preço</th>
                        <th>Quantidade</th>
                    </tr>
                </thead>

                <tbody>
                    @if (produtos.Count == 0)
                    {
                        <tr>
                            <td colspan="3" class="text-muted">
                                Nenhum Produto Cadastrado!
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var p in produtos)
                        {
                            <tr>
                                <td>@p.Nome</td>
                                <td>R$ @p.Preco.ToString("N2")</td>
                                <td>@p.Quantidade Un</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

        </div>
    </div>
</div>

@code {

    private Produto produto = new();

    private List<Produto> produtos = new();

    private string mensagem = "";

    private void AdicionarProduto()
    {
        produtos.Add(new Produto
        {
            Nome = produto.Nome.Trim(),
            Preco = produto.Preco,
            Quantidade = produto.Quantidade
        });

        mensagem = $"Produto {produto.Nome} cadastrado com sucesso!";

        // Cria um novo objeto e limpa o formulário
        produto = new Produto();
    }
}
